# Anthropic-compatible endpoint (MiniMax mainland example; choose your region).
AGENT_BASE_URL=https://api.minimaxi.com/anthropic
AGENT_MODEL=MiniMax-M3
# Replace with your own credential. Set exactly one authentication field.
AGENT_API_KEY=replace-with-your-api-key
AGENT_AUTH_TOKEN=
AGENT_MAX_TOKENS=4096
AGENT_MAX_MODEL_ROUNDS=16
AGENT_MAX_TOOL_CALLS=64
AGENT_MAX_TASK_SECONDS=1800
AGENT_MODEL_TIMEOUT_SECONDS=120
AGENT_ENABLE_BUILD_TOOLS=0
AGENT_BUILD_TIMEOUT_SECONDS=300
AGENT_ENABLE_RAG=1
AGENT_RAG_MODE=hybrid
# Optional: set an absolute complete pack path. If omitted, Ready uses its
# EXE-relative ..\AgentFramework-Knowledge\active-pack.json pointer.
AGENT_RAG_TOP_K=6
AGENT_RAG_MAX_TOTAL_BYTES=32768
AGENT_RAG_STARTUP_TIMEOUT_SECONDS=120
AGENT_RAG_QUERY_TIMEOUT_SECONDS=30
AGENT_RAG_DEVICE=auto
AGENT_RUNTIME_ROOT=runtime_data

# Long-term memory is enabled by default. Flags accept exactly 0 or 1.
# /memory off is temporary: it disables automatic retrieval/consolidation until
# /memory on or a new process. Explicit /remember, /memories and /forget remain.
AGENT_ENABLE_MEMORY=1
# Retrieval defaults: at most 5 matching entries and 4096 UTF-8 bytes of lines.
# TOP_K: 1..20; injected/entry byte limits: 1..1048576 each.
AGENT_MEMORY_TOP_K=5
AGENT_MEMORY_MAX_INJECTED_BYTES=4096
AGENT_MEMORY_MAX_ENTRY_BYTES=1024

# Compaction uses the same configured provider and remains active with memory off.
# Trigger uses estimated context bytes. Hard limit must be strictly larger.
# Both context byte settings: 1..16777216; retain turns: 1..10000.
AGENT_COMPACTION_THRESHOLD_BYTES=65536
AGENT_COMPACTION_HARD_LIMIT_BYTES=131072
AGENT_COMPACTION_RETAIN_TURNS=6
# Plain-text cumulative summary limit in UTF-8 bytes: 1..8192.
AGENT_COMPACTION_MAX_SUMMARY_BYTES=8192
